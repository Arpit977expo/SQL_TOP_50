select round(sum(if(min_order_date=min_pref,1,0))/count(customer_id)*100,2)
as immediate_percentage from
(select customer_id, 
min(order_date) as min_order_date,
min(customer_pref_delivery_date) as min_pref
from delivery
group by customer_id) as new_table;


